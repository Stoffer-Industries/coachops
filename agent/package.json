{
  "name": "@coachops/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "review": "tsx src/cli.ts review",
    "ready": "tsx src/cli.ts ready",
    "reset-demo": "tsx src/cli.ts reset-demo",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@coachops/shared": "0.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
