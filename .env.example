# Agent
PORT=8080
COACHOPS_STATE_PATH=.coachops/state.json
# Pin demo "now" for deterministic fixture reviews (NZ morning of demo day)
COACHOPS_DEMO_NOW=2026-11-25T08:00:00+13:00
# Local development mode (allows simulated auth for testing)
COACHOPS_LOCAL_DEV=true

# GymTrack MCP (per-user OAuth; never commit tokens)
GYMTRACK_MCP_URL=https://gymtrack-mcp.fly.dev/mcp
# Optional live clients overlay (JSON array of RosterClient). Tokens via env vars named in tokenEnvVar.
# COACHOPS_LIVE_ROSTER_JSON=[]

# Sprites Connectors (IDs only — credentials live in Fly Connectors dashboard)
COACHOPS_OPENROUTER_CONNECTION_ID=
COACHOPS_RESEND_CONNECTION_ID=
COACHOPS_RESEND_FROM=CoachOps Demo <onboarding@resend.dev>

# Dashboard (optional; Vite proxies /api → agent by default)
# VITE_AGENT_URL=http://127.0.0.1:8080
